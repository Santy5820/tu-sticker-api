# Puerto del servidor HTTP
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Cadena de conexión de MongoDB (no subir credenciales reales al repo)
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# Nombre de la base de datos
MONGO_DB_NAME=tu-sticker-api

# Secreto para JWT
JWT_SECRET=tu-sticker-secret-dev-change-me

# Provisioning automático del primer administrador
# En producción deben configurarse como secretos del proveedor de despliegue.
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Wompi Web Checkout
# Usa llaves de Sandbox durante desarrollo y de Producción al publicar.
WOMPI_ENABLED=false
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_REDIRECT_URL=
